# Copy to deploy/gcp/config.env (git-ignored) and fill in. No secrets go in this
# file: setup.sh asks for secret values interactively and stores them in Secret Manager.

PROJECT_ID="your-gcp-project-id"
REGION="asia-south1"                 # Mumbai — closest region to Andhra Pradesh

SERVICE="votewala"                   # Cloud Run service name
SQL_INSTANCE="votewala-db"           # Cloud SQL instance name
DB_TIER="db-g1-small"                # db-f1-micro is cheapest; db-custom-2-7680 for heavy traffic

MIN_INSTANCES="0"                    # 1 avoids cold starts (costs more)
MAX_INSTANCES="20"

# Public URL. Leave empty to use the *.run.app URL; set it after mapping a domain,
# e.g. "https://votewala.in", then re-run deploy.sh.
PUBLIC_URL=""

# Google OAuth client ID (public). The client secret is asked for by setup.sh.
GOOGLE_CLIENT_ID=""

# Comma-separated Google emails that become admins on sign-in.
ADMIN_EMAILS=""

# twilio | msg91
SMS_PROVIDER="msg91"
TWILIO_ACCOUNT_SID=""
TWILIO_FROM_NUMBER=""
MSG91_TEMPLATE_ID=""

RESULTS_MIN_SAMPLE="30"
RESULTS_BLACKOUT=""
