{
  "name": "votewala",
  "version": "1.0.0",
  "private": true,
  "description": "VoteWala \u2014 independent opinion polling on Andhra Pradesh MLA & MP candidates",
  "scripts": {
    "dev": "npm run brand && next dev",
    "build": "npm run brand -- --strict && prisma generate && next build",
    "start": "next start",
    "brand": "node scripts/brand-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "make-admin": "tsx scripts/make-admin.ts",
    "finalize": "tsx scripts/finalize.ts",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://votewala:votewala@localhost:5432/votewala_test} vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^5.6.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
