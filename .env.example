# ---- Database (PostgreSQL 14+) ----
DATABASE_URL="postgresql://votewala:votewala@localhost:5432/votewala"

# ---- NextAuth ----
# Public base URL of the site, e.g. https://votewala.in
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
# Authorised redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Mobile OTP ----
# Secret used to HMAC OTP codes at rest. Generate with: openssl rand -base64 32
OTP_SECRET=""
# console | twilio | msg91   ("console" logs codes to the server log; dev only)
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""   # DLT-approved template containing ##otp##

# ---- Administration ----
# Comma-separated Google account emails promoted to ADMIN on sign-in.
ADMIN_EMAILS=""

# ---- Scheduled jobs ----
# Bearer token required by /api/cron/finalize. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Minimum number of votes before percentages are shown on a results chart.
RESULTS_MIN_SAMPLE="30"

# Legal results blackout windows (comma-separated ISO start/end pairs). While a
# window is active no poll results are shown anywhere on the site, e.g. the 48
# hours before polling (RP Act 1951, s.126) and notified exit-poll periods (s.126A).
RESULTS_BLACKOUT=""
